#!/usr/bin/env bash
set -euo pipefail

# Imp passes the one-time registration payload through this environment
# variable. It must never be written to logs, image metadata, disk, or argv.
: "${IMP_GITHUB_JITCONFIG:?IMP_GITHUB_JITCONFIG is required}"

# actions-runner's run.sh consumes the JIT payload from this environment
# variable. Keep it out of argv and remove Imp's handoff variable immediately.
export ACTIONS_RUNNER_INPUT_JITCONFIG="$IMP_GITHUB_JITCONFIG"
unset IMP_GITHUB_JITCONFIG

# The guest agent runs this entrypoint as root. actions-runner requires this
# explicit opt-in even though the guest itself is ephemeral.
export RUNNER_ALLOW_RUNASROOT=1

cd /home/runner/actions-runner
exec ./run.sh
